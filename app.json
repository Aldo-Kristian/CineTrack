{
  "expo": {
    "name": "CineTrack",
    "slug": "CineTrack",
    "version": "2.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#141414",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.cinetrack.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-sharing",
      "expo-image",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "CineTrack accesses your photos so you can choose a custom poster.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#141414",
          "image": "./assets/images/logo-mark.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#141414",
            "image": "./assets/images/logo-mark.png"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2eb3e656-4376-4521-905d-bb3aa14fdb21"
      }
    },
    "owner": "aldo-kristian",
    "backgroundColor": "#141414"
  }
}
